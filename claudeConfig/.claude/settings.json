{
    "enabledPlugins": {
        "code-review@claude-plugins-official": true,
        "commit-commands@claude-plugins-official": true,
        "context7@claude-plugins-official": true,
        "frontend-design@claude-plugins-official": true,
        "playwright@claude-plugins-official": true,
        "security-guidance@claude-plugins-official": true,
        "supabase@claude-plugins-official": true,
        "superpowers@claude-plugins-official": true,
        "typescript-lsp@claude-plugins-official": true,
        "hookify@claude-plugins-official": false,
        "ralph-loop@claude-plugins-official": false
    },
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "disabledMcpjsonServers": [
        "claude.ai Asana",
        "claude.ai Atlassian",
        "claude.ai Box",
        "claude.ai Canva",
        "claude.ai Excalidraw",
        "claude.ai Figma",
        "claude.ai Gmail",
        "claude.ai Google Drive",
        "claude.ai HubSpot",
        "claude.ai Intercom",
        "claude.ai Linear",
        "claude.ai monday.com",
        "claude.ai Notion",
        "claude.ai tldraw"
    ],
    "permissions": {
        "allow": []
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/silent-mode-check.sh"
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/circuit-breaker.sh"
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/block-bash-file-write.sh"
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/block-bash-validation.sh"
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/block-orchestrator-merge.sh"
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/restrict-documentator-bash.sh"
                    }
                ]
            },
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/restrict-documentator-write.sh"
                    }
                ]
            },
            {
                "matcher": "SendMessage",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/block-premature-shutdowns.sh"
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/validate-before-review.sh",
                        "timeout": 180,
                        "statusMessage": "Validating before review/merge..."
                    }
                ]
            },
            {
                "matcher": "TeamDelete",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/teamdelete-gate.sh",
                        "timeout": 5,
                        "statusMessage": "Checking team teardown state..."
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "TeamDelete",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/teamdelete-cleanup.sh",
                        "timeout": 5
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "matcher": "simple-developer",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/typecheck-on-commit.sh",
                        "timeout": 120,
                        "statusMessage": "Validating typecheck..."
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/prettier-on-stop.sh",
                        "timeout": 60,
                        "statusMessage": "Validating prettier..."
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/run-unit-tests-app.sh",
                        "timeout": 180,
                        "statusMessage": "Running unit tests (app)..."
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/run-unit-tests-functions.sh",
                        "timeout": 180,
                        "statusMessage": "Running unit tests (functions)..."
                    },
                    {
                        "type": "command",
                        "command": "/home/developer/.claude/hooks/run-e2e-tests.sh",
                        "timeout": 600,
                        "statusMessage": "Running e2e tests..."
                    }
                ]
            }
        ]
    }
}