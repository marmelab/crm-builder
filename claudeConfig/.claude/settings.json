{
    "enabledPlugins": {
        "claude-code-setup@claude-plugins-official": true,
        "claude-md-management@claude-plugins-official": true,
        "code-review@claude-plugins-official": true,
        "code-simplifier@claude-plugins-official": true,
        "commit-commands@claude-plugins-official": true,
        "context7@claude-plugins-official": true,
        "feature-dev@claude-plugins-official": true,
        "frontend-design@claude-plugins-official": true,
        "github@claude-plugins-official": true,
        "hookify@claude-plugins-official": true,
        "playwright@claude-plugins-official": true,
        "pr-review-toolkit@claude-plugins-official": true,
        "security-guidance@claude-plugins-official": true,
        "skill-creator@claude-plugins-official": true,
        "supabase@claude-plugins-official": true,
        "superpowers@claude-plugins-official": true,
        "typescript-lsp@claude-plugins-official": true
    },
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "permissions": {
        "allow": []
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/silent-mode-check.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/circuit-breaker.sh"
                    }
                ]
            },
        ],
        "SubagentStop": [
            {
                "matcher": "developer",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-e2e-tests.sh",
                        "asyncRewake": true,
                        "rewakeMessage": "E2E tests failed after developer finished:",
                        "timeout": 120
                    }
                ]
            },
            {
                "matcher": "developer",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-unit-tests-app.sh",
                        "asyncRewake": true,
                        "rewakeMessage": "Unit tests (app) failed after developer finished:",
                        "timeout": 120
                    }
                ]
            },
            {
                "matcher": "developer",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-unit-tests-functions.sh",
                        "asyncRewake": true,
                        "rewakeMessage": "Unit tests (functions) failed after developer finished:",
                        "timeout": 120
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prettier-on-edit.sh"
                    }
                ]
            }
        ],
        "TaskCompleted": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-on-commit.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-on-complete.sh"
                    }
                ]
            }
        ],
        "TeammateIdle": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/token-stats.sh"
                    }
                ]
            }
        ]
    }
}